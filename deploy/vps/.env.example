# ─────────────────────────────────────────────────────────────────────────────
# Schedule Event V2 — VPS (Opsi B) — contoh konfigurasi lingkungan.
#
# Cara pakai:  cp .env.example .env   → isi nilai → docker compose up -d
# Nilai yang ditampilkan di sini HANYA contoh/placeholder — JANGAN dipakai
# untuk produksi. Generate rahasia sendiri:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres (dipakai juga untuk menyusun DATABASE_URL) ─────────────────────
POSTGRES_DB=metmal
POSTGRES_USER=metmal
# Password DB — WAJIB ganti dengan nilai kuat.
POSTGRES_PASSWORD=ganti-password-db-yang-kuat

# ── Backend (api service) ────────────────────────────────────────────────────
# Koneksi dari dalam network Docker (host: postgres). Postgres container TIDAK
# di-map ke host — seed/psql via `docker compose exec` (lihat README §6).
DATABASE_URL=postgres://metmal:ganti-password-db-yang-kuat@postgres:5432/metmal
# Rahasia JWT (sign access token) — WAJIB ganti: openssl rand -hex 32
JWT_SECRET=ganti-jwt-secret-panjang-acak

# Opsional — hanya isi bila cookie harus dikirim ke subdomain lain
# (mis. frontend di domain.com, API via api.domain.com). Kosongkan bila
# frontend & API satu origin (nginx proxy /api/v1 — rekomendasi).
# COOKIE_DOMAIN=.domain.com

# Opsional — origin yang diizinkan CORS saat API dipanggil lintas-origin.
# Default server "*". Format daftar dipisah koma bila lebih dari satu.
# CORS_ORIGIN=https://domain.com

# ── Media — Cloudflare R2 (bukan storage VPS!) ───────────────────────────────
# Media user (poster, galeri, dll) TETAP di R2. Backend hanya membuat URL
# presign (upload/download) via S3 SDK. Tidak ada volume media di VPS.
# Ambil dari dashboard Cloudflare → R2 → bucket metmal-gallery.
R2_ACCOUNT_ID=ganti-account-id-r2
R2_ACCESS_KEY_ID=ganti-access-key-id-r2
R2_SECRET_ACCESS_KEY=ganti-secret-access-key-r2
R2_BUCKET_NAME=metmal-gallery
# URL publik bucket (custom domain R2 bila ada; opsional — fallback helper
# public URL saja, presign tidak memerlukan ini).
R2_PUBLIC_URL=https://media.domain.com

# Proxy roster tenant MID (GET https://apiloyalty.metropolitanland.com/getAllTenants)
# Tanpa ini, /api/v1/tenant/roster membalas 500 (fail-closed).
MID_API_KEY=

# ── Frontend build (waktu `npm run build` di host, bukan runtime) ───────────
# Base URL REST yang di-compile ke bundle SPA. rest.ts membangun base sebagai
# `VITE_API_URL + '/api/v1'`, jadi JANGAN isi dengan path berakhiran /api/v1
# (akan jadi /api/v1/api/v1 → 404). Karena nginx mem-proxy /api/v1 ke backend,
# cukup kosongkan (relatif, satu origin). Isi hanya bila frontend dipisah,
# mis. https://api.domain.com (tanpa suffix /api/v1).
VITE_API_URL=

# ── CATATAN ──────────────────────────────────────────────────────────────────
# - Jangan commit .env (sudah di .gitignore). Salin contoh ini dan isi manual.
# - Seluruh nilai placeholder di atas PASTI gagal dipakai produksi — sengaja.
